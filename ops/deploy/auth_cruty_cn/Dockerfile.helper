ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
WORKDIR /app
COPY gosu-setpriv.sh /usr/local/bin/gosu
COPY --chown=node:node backend/package*.json /app/
COPY --chown=node:node backend/node_modules /app/node_modules
COPY --chown=node:node backend/scripts /app/scripts
COPY --chown=node:node helper-entrypoint.sh /app/helper-entrypoint.sh
RUN chmod 0555 /usr/local/bin/gosu /app/helper-entrypoint.sh
EXPOSE 8092
ENTRYPOINT ["/app/helper-entrypoint.sh"]
