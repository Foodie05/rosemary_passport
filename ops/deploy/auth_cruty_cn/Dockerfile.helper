ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates gosu \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --chown=node:node backend/package*.json /app/
COPY --chown=node:node backend/node_modules /app/node_modules
COPY --chown=node:node backend/scripts /app/scripts
COPY --chown=node:node helper-entrypoint.sh /app/helper-entrypoint.sh
RUN chmod 0555 /app/helper-entrypoint.sh
EXPOSE 8092
ENTRYPOINT ["/app/helper-entrypoint.sh"]
