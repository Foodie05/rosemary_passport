ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates gosu && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --chown=node:node backend/ /app/

RUN chmod +x /app/bin/passport_server /app/bin/migrate /app/bin/seed_local_admin /app/entrypoint.sh

EXPOSE 8091

ENTRYPOINT ["/app/entrypoint.sh"]
