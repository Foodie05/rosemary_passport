ARG NODE_IMAGE=node:20-bookworm-slim
FROM ${NODE_IMAGE}

RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/* /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

WORKDIR /app

COPY gosu-setpriv.sh /usr/local/bin/gosu
COPY --chown=node:node backend/ /app/

RUN chmod 0555 /usr/local/bin/gosu \
  && chmod +x /app/bin/passport_server /app/bin/migrate /app/bin/seed_local_admin /app/bin/verify_audit_chain /app/entrypoint.sh

EXPOSE 8091

ENTRYPOINT ["/app/entrypoint.sh"]
