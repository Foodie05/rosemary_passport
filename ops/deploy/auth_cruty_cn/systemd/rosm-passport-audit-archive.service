[Unit]
Description=Rosemary Passport signed audit archive
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
ExecStart=/srv/rosm-passport/current/archive_audit_to_s3.sh /srv/rosm-passport/current /etc/rosm-passport/runtime.env /etc/rosm-passport/secrets
Nice=10
NoNewPrivileges=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/etc/rosm-passport
ReadWritePaths=/srv/rosm-passport/current
