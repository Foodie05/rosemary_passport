SERVER_BASE_URL=https://apiauth.cruty.cn
WEB_BASE_URL=https://auth.cruty.cn
POSTGRES_IMAGE=postgres:16.15-bookworm@sha256:REPLACE_WITH_VERIFIED_DIGEST
NODE_IMAGE=node:20-bookworm-slim@sha256:REPLACE_WITH_VERIFIED_DIGEST
POSTGRES_USER=rosm_passport
POSTGRES_DB=rosm_passport
JWT_ISSUER=apiauth.cruty.cn
JWT_AUDIENCE=cruty-apps
JWT_ACTIVE_KID=signing-v1
DATA_ENCRYPTION_ACTIVE_KID=data-v1
ACCESS_TOKEN_TTL_SECONDS=900
FIRST_PARTY_REFRESH_TOKEN_TTL_SECONDS=43200
FIRST_PARTY_REMEMBERED_REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=2592000
# Set once to the first hardened production deployment time plus 14 days.
LEGACY_JSON_REFRESH_SUNSET_AT=REPLACE_WITH_FIRST_DEPLOYMENT_PLUS_14_DAYS_UTC
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=20
DB_CONNECT_TIMEOUT_SECONDS=2
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=2
DB_QUERY_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_MILLISECONDS=1000
HELPER_TIMEOUT_SECONDS=3
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=4
ARGON2_PARALLELISM=1
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_FROM="Cruty Auth <no-reply@example.com>"
SMTP_SECURE=true
EMAIL_CODE_TTL_SECONDS=300
OIDC_REQUIRE_PKCE=true
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1
CORS_ALLOWED_ORIGINS=https://auth.cruty.cn
LOCAL_ADMIN_EMAIL=bootstrap-admin@rosm.local
LOCAL_ADMIN_NICKNAME=Cruty Initial Admin
ROSM_SECRETS_DIR=/etc/rosm-passport/secrets
S3_ENDPOINT=https://s3.example.com
S3_BUCKET=rosm-passport-backups
S3_REGION=auto
# Keep true when the provider supports S3 Object Lock. Set false only with an
# approved, documented risk exception for a provider that cannot implement it.
S3_REQUIRE_OBJECT_LOCK=true
S3_OBJECT_LOCK_MIN_RETENTION_DAYS=30
