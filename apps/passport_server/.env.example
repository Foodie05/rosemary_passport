SERVER_BASE_URL=https://passport.example.com
WEB_BASE_URL=https://passport.example.com
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=rosm_passport
DB_PASSWORD_FILE=/run/secrets/rosm-passport/db_password
DB_NAME=rosm_passport
DB_SSL_MODE=require
JWT_ISSUER=rosm-passport
JWT_AUDIENCE=rosm-apps
JWT_ACTIVE_KID=signing-v1
JWT_SIGNING_KEYS_DIR=/run/secrets/rosm-passport/jwt
JWT_BINDING_KEY_FILE=/run/secrets/rosm-passport/jwt_binding_key
EMAIL_CODE_HMAC_KEY_FILE=/run/secrets/rosm-passport/email_code_hmac_key
DATA_ENCRYPTION_ACTIVE_KID=data-v1
DATA_ENCRYPTION_KEYS_DIR=/run/secrets/rosm-passport/data_keys
ACCESS_TOKEN_TTL_SECONDS=900
FIRST_PARTY_REFRESH_TOKEN_TTL_SECONDS=43200
FIRST_PARTY_REMEMBERED_REFRESH_TOKEN_TTL_SECONDS=2592000
REFRESH_TOKEN_TTL_SECONDS=2592000
ARGON2_MEMORY_KB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=1
ALIYUN_CAPTCHA_PREFIX=
ALIYUN_CAPTCHA_SCENE_ID=
ALIYUN_CAPTCHA_ACCESS_KEY_ID_FILE=/run/secrets/rosm-passport/aliyun_captcha_access_key_id
ALIYUN_CAPTCHA_ACCESS_KEY_SECRET_FILE=/run/secrets/rosm-passport/aliyun_captcha_access_key_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@example.com
SMTP_PASSWORD_FILE=/run/secrets/rosm-passport/smtp_password
SMTP_FROM=ROSM Passport <no-reply@example.com>
SMTP_SECURE=true
EMAIL_CODE_TTL_SECONDS=300
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_SCHEME_NAME=
ALIYUN_SMS_COUNTRY_CODE=86
ALIYUN_SMS_CODE_LENGTH=6
ALIYUN_SMS_VALID_TIME_SECONDS=300
ALIYUN_SMS_SEND_INTERVAL_SECONDS=60
ALIYUN_SMS_DUPLICATE_POLICY=1
OIDC_REQUIRE_PKCE=true
WEBAUTHN_ANDROID_ORIGINS=
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1
CORS_ALLOWED_ORIGINS=https://passport.example.com,http://localhost:5173
DB_POOL_MIN_CONNECTIONS=2
DB_POOL_MAX_CONNECTIONS=20
DB_CONNECT_TIMEOUT_SECONDS=2
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=2
DB_QUERY_TIMEOUT_SECONDS=5
DB_LOCK_TIMEOUT_MILLISECONDS=1000
HELPER_TIMEOUT_SECONDS=3
# Production uses HELPER_BASE_URL=http://identity_helper:8092 and a *_FILE secret.
HELPER_BASE_URL=
HELPER_SHARED_KEY_FILE=/run/secrets/rosm-passport/helper_shared_key
REQUIRE_FILE_SECRETS=true
